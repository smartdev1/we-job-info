# Database (Neon PostgreSQL managed)
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?sslmode=require

# LLM provider (abstraction core/llm)
LLM_PROVIDER=kilo
LLM_MODEL_EXTRACTION=claude-haiku-4-5
LLM_MODEL_COPYWRITING=claude-sonnet-4-5

# Kilo AI (OpenAI-compatible gateway) - default provider for V0/V1
KILO_API_KEY=your-kilo-api-key
KILO_API_URL=https://api.kilo.ai/v1
KILO_MODEL=

# Anthropic (optional, supported when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Monthly cost cap (USD)
LLM_MONTHLY_CAP_USD=20

# Auth (single user)
SESSION_SECRET=change-me-in-production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# Telegram (V3+)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# IMAP alerts (V2+)
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# App
APP_ENV=development
LOG_LEVEL=info
APP_BASE_URL=http://localhost:8000
FRONT_BASE_URL=http://localhost:3000
MAX_UPLOAD_MB=5
SSRF_MAX_REDIRECTS=3